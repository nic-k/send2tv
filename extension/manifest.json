{
  "manifest_version": 3,
  "name": "send2tv",
  "version": "1.0",
  "description": "Stuurt de huidige pagina of een link via een Home Assistant webhook naar je Android TV.",
  "permissions": [
    "storage",
    "contextMenus",
    "activeTab"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Stuur naar tv",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}